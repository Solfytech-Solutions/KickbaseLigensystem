name: Kickbase Daten aktualisieren

# on:
#   # Alle 4 Stunden automatisch
#   schedule:
#     - cron: "0 */4 * * *"
#   # Manuell auslösbar über GitHub UI (zum Testen)
#   workflow_dispatch:
# on:
#   workflow_dispatch:
#   schedule: 
#     - cron: "0 */4 * * *"

jobs:
  fetch-kickbase-data:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Repository auschecken
        uses: actions/checkout@v4

      - name: Python 3.11 einrichten
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: "pip"
          cache-dependency-path: scripts/requirements.txt

      - name: Abhängigkeiten installieren
        run: pip install -r scripts/requirements.txt

      - name: Kickbase Daten holen & in Firestore schreiben
        env:
          KICKBASE_EMAIL: ${{ secrets.KICKBASE_EMAIL }}
          KICKBASE_PASSWORD: ${{ secrets.KICKBASE_PASSWORD }}
          FIREBASE_SERVICE_ACCOUNT_JSON: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_JSON }}
          # Optional: Kommagetrennte Liga-IDs (leer = alle Ligen automatisch)
          KICKBASE_LEAGUE_IDS: ${{ secrets.KICKBASE_LEAGUE_IDS }}
        run: python scripts/fetch_data.py
