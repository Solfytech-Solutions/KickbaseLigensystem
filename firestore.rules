rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Öffentlich lesbar (Frontend kann ohne Authentifizierung lesen)
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if false;  // Nur Server-seitig via Admin SDK

      match /squads/{userId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
