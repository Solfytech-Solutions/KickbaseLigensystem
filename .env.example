# Kickbase Zugangsdaten
KICKBASE_EMAIL=deine@email.com
KICKBASE_PASSWORD=deinpasswort

# Firebase Service Account JSON (kompakt, einzeilig)
# Aus Firebase Console → Projekteinstellungen → Dienstkonten → Neuen privaten Schlüssel generieren
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: Wenn du nur bestimmte Ligen laden möchtest (kommagetrennte IDs).
# Leer lassen → alle Ligen des Accounts werden automatisch geladen.
KICKBASE_LEAGUE_IDS=
