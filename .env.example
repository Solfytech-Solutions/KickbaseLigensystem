# Kickbase Zugangsdaten (in GitHub als Repository Secrets hinterlegen)
KICKBASE_EMAIL=deine@email.com
KICKBASE_PASSWORD=deinpasswort

# Optional: Wenn du nur bestimmte Ligen laden möchtest (kommagetrennte IDs).
# Leer lassen → alle Ligen des Accounts werden automatisch geladen.
KICKBASE_LEAGUE_IDS=
